# Dependencies
node_modules
apps/*/node_modules
packages/*/node_modules
# Prefer root pnpm-lock.yaml; ignore accidental npm locks from local tooling.
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock

# Build outputs
dist
apps/*/dist
packages/*/dist
build
apps/*/build
.turbo
.next
out

# Logs & caches
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache
.parcel-cache
.eslintcache
*.tsbuildinfo
coverage
.nyc_output

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Local env files — never commit secrets. Keep `.env.example`.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Expo / React Native
.expo
.expo-shared
apps/mobile/.expo
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*
web-build

# Vite
apps/web/dist

# Editor / IDE (local)
.idea
*.swp
*.swo

# Supabase CLI working directories (auto-generated by `supabase start`).
supabase/.temp/
supabase/.branches/

# Misc local tooling
.vercel
.vscode/*
!.vscode/extensions.json
