# GoldLink Bank — environment template.
#
# Copy to .env.local for local development. `.env` / `.env.local` are gitignored;
# this `.env.example` file is safe to commit.
#
# The apps default to JSON fixtures + simulated auth. Set BOTH mode vars to
# "supabase" (and provide URL + anon key) to flip onto a real backend.

# ----------------------------------------------------------------------------
# Mode switches — consumed by @goldlink/core's createRepositories() and
# createAuthProvider() factories.
# ----------------------------------------------------------------------------

# "json" (default) reads db/*.json, writes go to an in-memory layer that is
# lost on reload. "supabase" reads/writes against a real Postgres backend
# and requires the SUPABASE_* values below.
GOLDLINK_DATA_MODE=json

# "simulated" (default) accepts any 6-digit OTP and mints a fake JWT.
# "supabase" delegates to Supabase Auth.
GOLDLINK_AUTH_MODE=simulated

# ----------------------------------------------------------------------------
# Supabase project credentials — only required when GOLDLINK_DATA_MODE or
# GOLDLINK_AUTH_MODE is set to "supabase". After `supabase start`, run
# `supabase status` and copy the values here.
# ----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used by the `pnpm db:seed` script (psql connection string). The default
# matches a local `supabase start` stack — change it if you're seeding a
# remote/cloud Supabase project.
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ----------------------------------------------------------------------------
# App-specific env vars — each app decides how to surface SUPABASE_URL /
# SUPABASE_ANON_KEY to its runtime. Uncomment + set whichever you need.
# ----------------------------------------------------------------------------

# apps/web (Vite — exposed to the browser)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# apps/mobile (Expo — exposed via process.env.EXPO_PUBLIC_*)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
